  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Précision par catégorie sur le dernier jeu envoyé à /evaluate.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 3, "max": 1, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "green", "value": 0.9 }] }, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "targets": [{ "expr": "model_precision_score_by_category", "instant": true, "legendFormat": "{{category}}", "refId": "A" }],
      "title": "Précision par catégorie",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Rappel par catégorie sur le dernier jeu envoyé à /evaluate.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 3, "max": 1, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "green", "value": 0.9 }] }, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "targets": [{ "expr": "model_recall_score_by_category", "instant": true, "legendFormat": "{{category}}", "refId": "A" }],
      "title": "Rappel par catégorie",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Score F1 par catégorie sur le dernier jeu envoyé à /evaluate.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 3, "max": 1, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "green", "value": 0.9 }] }, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "targets": [{ "expr": "model_f1_score_by_category", "instant": true, "legendFormat": "{{category}}", "refId": "A" }],
      "title": "F1 par catégorie",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Dernière accuracy globale calculée par /evaluate.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 3, "max": 1, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "green", "value": 0.9 }] }, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [{ "expr": "model_accuracy_score", "instant": true, "refId": "A" }],
      "title": "Model Accuracy",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Nombre de prédictions par catégorie sur la période sélectionnée.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 8 },
      "id": 5,
      "options": { "displayLabels": ["name", "value"], "legend": { "displayMode": "list", "placement": "right", "showLegend": true }, "pieType": "donut", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [{ "expr": "sum by (category) (increase(predictions_by_category_total[$__range]))", "legendFormat": "{{category}}", "refId": "A" }],
      "title": "Prediction Distribution by Category",
      "type": "piechart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Évolution du débit de prédictions par catégorie.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "stacking": { "mode": "normal", "group": "A" } } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 8 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum by (category) (rate(predictions_by_category_total[$__rate_interval]))", "legendFormat": "{{category}}", "refId": "A" }],
      "title": "Prédictions par catégorie dans le temps",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Quantiles de longueur des textes soumis à /predict, calculés avec l'histogramme Prometheus.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short", "custom": { "axisLabel": "Caractères", "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(input_text_length_histogram_bucket[$__rate_interval])))", "legendFormat": "P50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(input_text_length_histogram_bucket[$__rate_interval])))", "legendFormat": "P95", "refId": "B" }
      ],
      "title": "Longueur des textes d'entrée (P50 / P95)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Quantiles des scores de confiance retournés par le modèle.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "max": 1, "min": 0, "unit": "percentunit", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 8,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(prediction_confidence_score_bucket[$__rate_interval])))", "legendFormat": "Confiance médiane (P50)", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(prediction_confidence_score_bucket[$__rate_interval])))", "legendFormat": "Confiance P95", "refId": "B" },
        { "expr": "sum(rate(prediction_confidence_score_sum[$__rate_interval])) / clamp_min(sum(rate(prediction_confidence_score_count[$__rate_interval])), 1e-9)", "legendFormat": "Confiance moyenne", "refId": "C" }
      ],
      "title": "Distribution du score de confiance",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["model", "evaluation", "prometheus"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
