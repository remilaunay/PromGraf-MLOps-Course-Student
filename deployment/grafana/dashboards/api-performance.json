{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Performances et activité de la News Classifier API à partir des métriques Prometheus.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "État du scrape Prometheus pour l'API de classification.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "mappings": [{ "type": "value", "options": { "0": { "color": "red", "index": 0, "text": "DOWN" }, "1": { "color": "green", "index": 1, "text": "UP" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 14, "w": 5, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [{ "expr": "up{job=\"news_classifier_api\"}", "instant": true, "legendFormat": "API", "refId": "A" }],
      "title": "Statut API News Classifier",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Nombre de prédictions par catégorie sur la période sélectionnée.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 14, "w": 8, "x": 5, "y": 0 },
      "id": 2,
      "options": { "displayLabels": ["name", "value"], "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "pieType": "pie", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [{ "expr": "sum by (category) (increase(predictions_by_category_total[$__range]))", "instant": true, "legendFormat": "{{category}}", "refId": "A" }],
      "title": "Predictions by Category",
      "type": "piechart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Latence moyenne des requêtes /predict, filtrable par méthode et code HTTP.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 1 }] }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 5, "x": 13, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [{ "expr": "sum(rate(api_request_duration_seconds_sum{endpoint=\"/predict\",method=~\"$method\",status_code=~\"$status_code\"}[5m])) / clamp_min(sum(rate(api_request_duration_seconds_count{endpoint=\"/predict\",method=~\"$method\",status_code=~\"$status_code\"}[5m])), 1e-9)", "instant": true, "legendFormat": "", "refId": "A" }],
      "title": "Average predict Latency",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Latence moyenne des évaluations, filtrable par méthode et code HTTP.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 10 }, { "color": "red", "value": 30 }] }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [{ "expr": "sum(rate(api_request_duration_seconds_sum{endpoint=\"/evaluate\",method=~\"$method\",status_code=~\"$status_code\"}[5m])) / clamp_min(sum(rate(api_request_duration_seconds_count{endpoint=\"/evaluate\",method=~\"$method\",status_code=~\"$status_code\"}[5m])), 1e-9)", "instant": true, "legendFormat": "", "refId": "A" }],
      "title": "Average Evaluation Latency",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Nombre total de requêtes correspondant aux filtres sur la période sélectionnée.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 5, "x": 13, "y": 7 },
      "id": 5,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [{ "expr": "sum(increase(api_requests_total{endpoint=~\"$endpoint\",method=~\"$method\",status_code=~\"$status_code\"}[$__range]))", "instant": true, "legendFormat": "Requêtes", "refId": "A" }],
      "title": "API requests sum",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Nombre total de réponses HTTP 4xx et 5xx sur la période sélectionnée.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 7 },
      "id": 6,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [{ "expr": "sum(increase(api_requests_total{endpoint=~\"$endpoint\",method=~\"$method\",status_code=~\"$status_code\",status_code=~\"4..|5..\"}[$__range])) or vector(0)", "instant": true, "legendFormat": "Erreurs", "refId": "A" }],
      "title": "Requests Errors",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Débit de requêtes par endpoint sur les 30 dernières minutes, filtrable par endpoint, méthode et code HTTP.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never" } }, "overrides": [] },
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 14 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum by (endpoint) (rate(api_requests_total{endpoint=~\"$endpoint\",method=~\"$method\",status_code=~\"$status_code\"}[30m]))", "legendFormat": "{{endpoint}}", "refId": "A" }],
      "title": "Requests by endpoint",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "95e percentile de latence par endpoint sur les cinq dernières minutes.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 3, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 1 }] }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 14 },
      "id": 8,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (endpoint, le) (rate(api_request_duration_seconds_bucket{endpoint=~\"$endpoint\",method=~\"$method\",status_code=~\"$status_code\"}[5m])))", "instant": true, "legendFormat": "{{endpoint}}", "refId": "A" }],
      "title": "P95 latency",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["api", "prometheus", "performance"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(api_requests_total, endpoint)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "name": "endpoint",
        "query": { "query": "label_values(api_requests_total, endpoint)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(api_requests_total{endpoint=~\"$endpoint\"}, method)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "name": "method",
        "query": { "query": "label_values(api_requests_total{endpoint=~\"$endpoint\"}, method)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(api_requests_total{endpoint=~\"$endpoint\",method=~\"$method\"}, status_code)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "name": "status_code",
        "query": { "query": "label_values(api_requests_total{endpoint=~\"$endpoint\",method=~\"$method\"}, status_code)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Performance API",
  "uid": "api-performance",
  "version": 3
}
