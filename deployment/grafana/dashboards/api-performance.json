{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Performances et activité de la News Classifier API à partir des métriques Prometheus.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Nombre total de requêtes correspondant aux filtres sélectionnés sur la période affichée.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "expr": "sum(increase(api_requests_total{endpoint=~\"$endpoint\",method=~\"$method\",status_code=~\"$status_code\"}[$__range]))", "legendFormat": "Requêtes", "refId": "A" }],
      "title": "Requêtes totales",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Débit de requêtes par endpoint, calculé sur les 30 dernières minutes et filtrable par méthode et code HTTP.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum by (endpoint) (rate(api_requests_total{endpoint=~\"$endpoint\",method=~\"$method\",status_code=~\"$status_code\"}[30m]))", "legendFormat": "{{endpoint}}", "refId": "A" }],
      "title": "Taux de requêtes par endpoint",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "95e percentile de latence par endpoint sur les cinq dernières minutes, filtrable par endpoint, méthode et code HTTP.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (endpoint, le) (rate(api_request_duration_seconds_bucket{endpoint=~\"$endpoint\",method=~\"$method\",status_code=~\"$status_code\"}[5m])))", "legendFormat": "P95 {{endpoint}}", "refId": "A" }],
      "title": "Latence P95 par endpoint",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Débit des réponses en erreur par endpoint et code HTTP, filtrable avec les variables du dashboard.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum by (endpoint, status_code) (rate(api_requests_total{endpoint=~\"$endpoint\",method=~\"$method\",status_code=~\"$status_code\",status_code=~\"4..|5..\"}[5m]))", "legendFormat": "{{endpoint}} · HTTP {{status_code}}", "refId": "A" }],
      "title": "Taux d'erreur par endpoint et code HTTP",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Nombre de prédictions par catégorie retournée par le modèle.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "options": { "displayLabels": ["name", "value"], "legend": { "displayMode": "list", "placement": "right", "showLegend": true }, "pieType": "donut", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [{ "expr": "sum by (category) (increase(predictions_by_category_total[$__range]))", "legendFormat": "{{category}}", "refId": "A" }],
      "title": "Répartition des prédictions par catégorie",
      "type": "piechart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Volume et latence moyenne par code HTTP, selon les filtres endpoint et méthode sélectionnés.",
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [{ "matcher": { "id": "byName", "options": "Latence moyenne (s)" }, "properties": [{ "id": "unit", "value": "s" }] }] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 6,
      "options": { "cellHeight": "sm", "showHeader": true, "sortBy": [{ "desc": true, "displayName": "Requêtes" }] },
      "targets": [
        { "expr": "sum by (status_code) (increase(api_requests_total{endpoint=~\"$endpoint\",method=~\"$method\",status_code=~\"$status_code\"}[$__range]))", "format": "table", "instant": true, "legendFormat": "Requêtes", "refId": "A" },
        { "expr": "sum by (status_code) (rate(api_request_duration_seconds_sum{endpoint=~\"$endpoint\",method=~\"$method\",status_code=~\"$status_code\"}[$__rate_interval])) / clamp_min(sum by (status_code) (rate(api_request_duration_seconds_count{endpoint=~\"$endpoint\",method=~\"$method\",status_code=~\"$status_code\"}[$__rate_interval])), 1e-9)", "format": "table", "instant": true, "legendFormat": "Latence moyenne (s)", "refId": "B" }
      ],
      "title": "Détail par code HTTP (selon les filtres)",
      "transformations": [{ "id": "joinByField", "options": { "byField": "status_code", "mode": "outer" } }, { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value #A": "Requêtes", "Value #B": "Latence moyenne (s)" } } }],
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["api", "prometheus", "performance"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(api_requests_total, endpoint)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "name": "endpoint",
        "query": { "query": "label_values(api_requests_total, endpoint)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(api_requests_total{endpoint=~\"$endpoint\"}, method)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "name": "method",
        "query": { "query": "label_values(api_requests_total{endpoint=~\"$endpoint\"}, method)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(api_requests_total{endpoint=~\"$endpoint\",method=~\"$method\"}, status_code)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "name": "status_code",
        "query": { "query": "label_values(api_requests_total{endpoint=~\"$endpoint\",method=~\"$method\"}, status_code)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Performances de l'API",
  "uid": "api-performance",
  "version": 2
}
