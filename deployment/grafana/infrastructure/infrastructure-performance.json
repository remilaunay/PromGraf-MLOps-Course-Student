{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Utilisation CPU, mémoire et espace disque de l'hôte, collectée par Node Exporter.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Utilisation CPU en pourcentage, calculée comme 100 moins la part idle moyenne sur les cinq dernières minutes.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 100,
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 }] },
          "unit": "percent",
          "custom": { "axisLabel": "CPU", "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" }
        },
        "overrides": []
      },
      "gridPos": { "h": 12, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true, "sizing": "auto", "orientation": "auto" },
      "targets": [{ "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{job=\"node_exporter\",mode=\"idle\",instance=~\"$instance\"}[5m])) * 100)", "instant": true, "legendFormat": "{{instance}}", "refId": "A" }],
      "title": "CPU Usage",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Pourcentage de mémoire utilisée, calculé à partir de MemFree comme dans l'exercice.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 100,
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 80 }] },
          "unit": "percent",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" }
        },
        "overrides": []
      },
      "gridPos": { "h": 12, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true, "sizing": "auto", "orientation": "auto" },
      "targets": [{ "expr": "(node_memory_MemTotal_bytes{job=\"node_exporter\",instance=~\"$instance\"} - node_memory_MemFree_bytes{job=\"node_exporter\",instance=~\"$instance\"}) / node_memory_MemTotal_bytes{job=\"node_exporter\",instance=~\"$instance\"} * 100", "instant": true, "legendFormat": "{{instance}}", "refId": "A" }],
      "title": "Memory Usage",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Espace disque utilisé par système de fichiers, en excluant les systèmes tmpfs.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 100,
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 90 }] },
          "unit": "percent",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" }
        },
        "overrides": []
      },
      "gridPos": { "h": 12, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true, "sizing": "auto", "orientation": "auto" },
      "targets": [{ "expr": "100 - (node_filesystem_avail_bytes{job=\"node_exporter\",fstype!=\"tmpfs\",mountpoint=\"/\",instance=~\"$instance\"} / node_filesystem_size_bytes{job=\"node_exporter\",fstype!=\"tmpfs\",mountpoint=\"/\",instance=~\"$instance\"} * 100)", "instant": true, "legendFormat": "{{instance}} {{mountpoint}}", "refId": "A" }],
      "title": "Disk usage",
      "type": "gauge"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["infrastructure", "node-exporter", "prometheus"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(node_cpu_seconds_total{job=\"node_exporter\"}, instance)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "name": "instance",
        "query": { "query": "label_values(node_cpu_seconds_total{job=\"node_exporter\"}, instance)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Infrastructure",
  "uid": "infrastructure-performance",
  "version": 1
}
